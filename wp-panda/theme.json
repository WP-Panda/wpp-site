{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1200px"
    },
    "color": {
      "defaultPalette": false,
      "palette": [
        { "name": "Panda yellow", "slug": "brand", "color": "#ffc21f" },
        { "name": "Ink", "slug": "ink", "color": "#1c1c21" },
        { "name": "Muted", "slug": "muted", "color": "#7b7b87" },
        { "name": "Soft", "slug": "soft", "color": "#f6f6f8" },
        { "name": "White", "slug": "white", "color": "#ffffff" }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "fontFamily": "Montserrat, ui-sans-serif, system-ui, sans-serif",
          "name": "Montserrat",
          "slug": "montserrat"
        },
        {
          "fontFamily": "JetBrains Mono, ui-monospace, monospace",
          "name": "JetBrains Mono",
          "slug": "jetbrains-mono"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "#ffffff",
      "text": "#1c1c21"
    },
    "typography": {
      "fontFamily": "Montserrat, ui-sans-serif, system-ui, sans-serif",
      "lineHeight": "1.6"
    },
    "elements": {
      "link": {
        "color": { "text": "inherit" }
      }
    }
  }
}
